rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Listings are publicly readable (browse/search/detail pages are not
    // behind login), but can only be created/edited/deleted by their owner.
    match /listings/{listingId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.userRef == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userRef == request.auth.uid
                    && request.resource.data.userRef == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.userRef == request.auth.uid;
    }

    // A single user profile (name/email) can be looked up by id — used by
    // the "Contact Landlord" feature, which is reachable without signing in.
    // Bulk listing of all users is never needed by the app and is denied.
    match /users/{userId} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
