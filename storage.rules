rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Listing photos are stored as flat files named "<uploaderUid>-<name>-<uuid>".
    // They must be publicly viewable (listing photos are shown to all visitors),
    // but only the uploader may write a file under their own uid prefix, and
    // only images under a reasonable size are accepted.
    match /{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && fileName.matches(request.auth.uid + '-.*')
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
