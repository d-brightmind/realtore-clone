# Firebase project config (Project settings -> General -> Your apps).
# All of these except VITE_FIREBASE_MEASUREMENT_ID are required —
# the app throws a clear startup error if any are missing (src/firebase.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Geocoding API key. Optional: only used if automatic
# address-to-coordinates lookup is enabled (off by default — see
# geolocationEnabled in CreateListing.tsx / EditListing.tsx). Not
# currently validated at startup since it's not required by default.
# Note: this key is exposed in the client bundle and in every outgoing
# geocode request's URL — restrict it (HTTP referrer + API restriction)
# in Google Cloud Console before enabling automatic geocoding.
VITE_GEOCODE_API_KEY=
